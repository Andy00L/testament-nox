# Copy to .env and fill. .env is gitignored and must never be committed.
# Every key here is a throwaway testnet key. Never put a key holding real funds in it.

# ---- Network ----
# Ethereum Sepolia. Nox deploys NoxCompute here, so this is the only supported public chain.
#
# Whatever endpoint you use must serve eth_maxPriorityFeePerGas: viem needs it to build an
# EIP-1559 transaction, and an endpoint that answers eth_gasPrice but not this one fails at
# deploy time with an opaque "Internal error". Infura's free Sepolia tier does exactly that.
# publicnode serves it and needs no key.
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
ETHERSCAN_API_KEY=

# ---- Accounts ----
# Deployer, testament owner, and Safe owner. Needs Sepolia ETH.
DEPLOYER_PRIVATE_KEY=
DEPLOYER_ADDRESS=

# Beneficiaries. Only ever receive, so their private keys are optional and exist
# only so a beneficiary wallet can be connected during the demo.
BENEFICIARY_A=
BENEFICIARY_A_PRIVATE_KEY=
BENEFICIARY_B=
BENEFICIARY_B_PRIVATE_KEY=

# ---- Deployment output, filled by scripts/deploy.ts ----
REGISTRY_ADDRESS=
MODULE_ADDRESS=

# ---- Safe ----
# 1-of-1 Safe on Sepolia owned by DEPLOYER_ADDRESS, funded with the estate.
SAFE_ADDRESS=

# ---- Demo timings, seconds ----
# Production defaults are 30 days / 7 days. These short values exist for the video.
DEMO_INTERVAL=90
DEMO_GRACE=30

# ---- Keeper ----
# The account that pays gas for release() and execute(). It holds no authority: every
# decryption proof is verified on-chain, so a hostile keeper can only waste its own gas.
# A separate throwaway key from the deployer is fine and preferable.
KEEPER_PRIVATE_KEY=

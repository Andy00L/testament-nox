{
  "name": "@testament/contracts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "TestamentRegistry (Nox confidential) and TestamentModule (Safe module).",
  "license": "MIT",
  "scripts": {
    "build": "hardhat build && bun run scripts/export-abis.ts",
    "test": "hardhat test",
    "deploy:sepolia": "hardhat run scripts/deploy.ts --network sepolia",
    "enable-module:sepolia": "hardhat run scripts/enable-module.ts --network sepolia",
    "e2e:sepolia": "hardhat run scripts/e2e-sepolia.ts --network sepolia",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@iexec-nox/nox-protocol-contracts": "^0.2.4",
    "@openzeppelin/contracts": "^5.6.1",
    "@testament/shared": "workspace:*",
    "viem": "^2.55.10"
  },
  "devDependencies": {
    "@iexec-nox/handle": "^0.1.0-beta.13",
    "@iexec-nox/nox-hardhat-plugin": "^0.1.0",
    "@nomicfoundation/hardhat-toolbox-viem": "^5.0.7",
    "@tsconfig/node22": "^22.0.2",
    "@types/node": "^22.11.0",
    "dotenv": "^17.4.2",
    "hardhat": "^3.11.1",
    "typescript": "~5.8.0"
  }
}

# Copy to .env.local. Every value here is public by definition: it ships in the browser bundle.
# Never put a private key in this file.

# Deployed on Ethereum Sepolia.
NEXT_PUBLIC_REGISTRY_ADDRESS=
NEXT_PUBLIC_MODULE_ADDRESS=

# Must serve eth_maxPriorityFeePerGas. Infura's free Sepolia tier does not.
NEXT_PUBLIC_SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Optional. Without it the app still works with an injected wallet.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
